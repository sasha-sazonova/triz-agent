# Copy to .env and fill in only the keys you need. Never commit .env.

# Semantic Scholar (optional; higher rate limit with a key)
SEMANTIC_SCHOLAR_API_KEY=

# EPO OPS (Espacenet) — patent search
EPO_OPS_KEY=
EPO_OPS_SECRET=

# USPTO Open Data Portal — US patents
USPTO_ODP_KEY=

# Rospatent online API — RU patents (if issued)
ROSPATENT_KEY=
